// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 8,

    "modules-left": [
        "niri/workspaces",
        "niri/window"
    ],
    "modules-center": [
        "custom/nowplaying"
    ],
    "modules-right": [
        "pulseaudio",
        "network",
        "cpu",
        "memory",
        "battery",
        "clock",
        "tray"
    ],

    "custom/nowplaying": {
        "exec": "playerctl metadata --format '{{ artist }} - {{ title }}' 2>/dev/null",
        "exec-if": "playerctl status 2>/dev/null",
        "interval": 1,
        "return-type": "text",
        "on-click": "playerctl play-pause"
    },

    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六",
            "7": "七",
            "8": "八",
            "9": "九",
            "10": "十",
            "default": "{value}"
        }
    },

    "niri/window": {
        "format": "{title}",
        "max-length": 120,
        "tooltip": false
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "{icon}  Muted",
        "format-icons": {
            "headphone": "<span face='JetBrainsMono Nerd Font' ></span>",
            "hands-free": "<span face='JetBrainsMono Nerd Font' >󰋋</span>",
            "headset": "<span face='JetBrainsMono Nerd Font' >󰋋</span>",
            "default": ["<span face='JetBrainsMono Nerd Font'></span>"/* , "<span face='JetBrainsMono Nerd Font'> </span>", "<span face='JetBrainsMono Nerd Font'> </span>" */]
        },
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": "<span face='JetBrainsMono Nerd Font' > </span> {essid}",
        "format-ethernet": "<span face='JetBrainsMono Nerd Font' >󰈀 </span> {ipaddr}",
        "format-linked": "<span face='JetBrainsMono Nerd Font' > </span> {ifname} (No IP)",
        "format-disconnected": "<span face='JetBrainsMono Nerd Font' > </span> Disconnected",
        "tooltip-format": "{ifname}\n{ipaddr}\nSignal: {signalStrength}%"
    },

    "cpu": {
        "format": "CPU: {usage}%",
        "tooltip": false
    },

    "memory": {
        "format": "MEM: {}%"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "BAT: {capacity}%",
        "format-charging": "BAT: +{capacity}%",
        "format-plugged": "BAT: {capacity}%",
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },

    "tray": {
        "spacing": 10,
        "icon-size": 16
    }
}
